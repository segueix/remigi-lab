{
  "name": "@remigi/core",
  "version": "0.1.0",
  "description": "Motor del joc de Rummikub: regles, IA per nivells i dificultat adaptativa",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:engine": "vitest run test/engine.test.ts test/engineRegression.test.ts test/engineArtifact.test.ts",
    "test:lab": "vitest run test/hieroglyph.test.ts test/labCatalog.test.ts test/labMatch.test.ts test/labTournament.test.ts test/labReport.test.ts",
    "build:engine": "node scripts/build-engine.mjs",
    "smoke:engine": "node scripts/engine-smoke.mjs",
    "simulate": "tsx src/cli/simulate.ts",
    "lab": "tsx src/cli/lab.ts"
  },
  "devDependencies": {
    "@types/node": "^22.5.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.19.0",
    "typescript": "^5.6.2",
    "vitest": "^4.1.11"
  }
}
